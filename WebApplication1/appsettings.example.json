{
  ""ConnectionStrings"": {
    ""DefaultConnection"": ""Host=localhost;Port=5432;Database=YourDatabaseName;Username=your_username;Password=your_password""
  },
  ""EmailSettings"": {
    ""SmtpServer"": ""smtp.example.com"",
    ""SmtpPort"": 587,
    ""SenderEmail"": ""your-email@example.com"",
    ""SenderPassword"": ""your-app-specific-password"",
    ""SenderName"": ""Game Auth System"",
    ""EnableSsl"": true,
    ""TestMode"": false,
    ""FrontendUrl"": ""http://localhost:3000""
  },
  ""JwtSettings"": {
    ""Key"": ""min-32-characters-long-secret-key-here-for-jwt"",
