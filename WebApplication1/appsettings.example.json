{
  "ServerSettings": {
    "BaseUrl": "http://localhost:5000",
    "PistonUrl": "http://localhost:2000"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=YourDatabaseName;Username=your_username;Password=your_password"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "SmtpPort": 587,
    "SenderEmail": "your-email@example.com",
    "SenderPassword": "your-app-specific-password",
    "SenderName": "Game Auth System",
    "EnableSsl": true,
    "TestMode": false,
    "FrontendUrl": "http://localhost:3000"
  },
  "JwtSettings": {
    "Key": "min-32-characters-long-secret-key-here-for-jwt-change-this",
    "Issuer": "YourAppServer",
    "Audience": "YourAppClient",
    "ExpireDays": 7
  },
  "PistonApi": {
    "BaseUrl": "http://localhost:2000"
  },
  "AppSettings": {
    "OtpExpirationMinutes": 15,
    "PasswordResetExpirationHours": 1,
    "InitialEloRating": 500,
    "LevelUpThreshold": 1000,
    "ResetPasswordPath": "/static/reset-password.html",
    "MaxPasswordResetAttempts": 3,
    "PasswordResetBlockMinutes": 15
  },
  "SecuritySettings": {
    "RateLimitRequests": 5,
    "RateLimitMinutes": 1,
    "EnableIpTracking": true,
    "RequireEmailConfirmation": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.AspNetCore.Authorization": "Information",
      "Microsoft.AspNetCore.Mvc": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "WebApplication1": "Information",
      "WebApplication1.Controllers": "Information",
      "WebApplication1.Services": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:7000"
      }
    }
  }
}